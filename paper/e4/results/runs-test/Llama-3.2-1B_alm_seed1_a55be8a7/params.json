{
  "model_name": "meta-llama/Llama-3.2-1B",
  "data_save_dir": "data/codeparrot_tokenized_lamma32_1B_1024",
  "context_length": 1024,
  "method": "alm",
  "num_epochs": 1,
  "batch_size": 16,
  "gradient_accumulation_steps": 8,
  "gradient_checkpointing": false,
  "primal_lr": 5e-05,
  "weight_decay": 0.01,
  "seed": 1,
  "eval_steps": 800,
  "device": "cuda",
  "verbose": true,
  "candidates_to_sparsify": {
    "mlp": "down_proj",
    "self_attn": "o_proj"
  },
  "init_mean": 4.5,
  "target_density": 0.7,
  "per_layer": true,
  "primal_lr_gates": 3.0,
  "alm": {
    "lr": 0.1,
    "init_duals": 0.001,
    "dual_range": [
      -100.0,
      100.0
    ],
    "is_ineq": true,
    "penalty": 1.0
  }
}